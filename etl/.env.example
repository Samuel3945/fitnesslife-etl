# Source: MongoDB Atlas (read-only user)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=fitnesslife

# Target: Azure SQL Database (data warehouse)
AZURE_SQL_SERVER=<server>.database.windows.net
AZURE_SQL_DATABASE=<database>
AZURE_SQL_USER=<user>
AZURE_SQL_PASSWORD=<password>

# Optional. Leave empty: the application stores gym wall-clock time and the ETL
# keeps it as-is. Set an IANA zone (e.g. America/Bogota) only if the source
# starts storing true UTC timestamps.
ETL_SOURCE_TIMEZONE=

# Optional. Abort the publish if the new load has fewer fact rows than this
# fraction of the rows currently published (protects against partial reads).
ETL_MIN_PUBLISH_RATIO=0.5
